{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 300,
      "includeFiles": "{index.html,css/**,js/**,data/*.txt,data/temas.js,data/mistura.js,manifest.webmanifest,sw.js,icon.svg}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}
