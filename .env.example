# Copie para .env e preencha. A IA confere palavras que não estão no dicionário.
# Qualquer API compatível com OpenAI funciona. Exemplos:
#   FreeLLMAPI (proxy local de LLMs grátis): LLM_BASE_URL=http://localhost:3001/v1   (use a porta do seu FreeLLMAPI)
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1        LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1           LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=6000
